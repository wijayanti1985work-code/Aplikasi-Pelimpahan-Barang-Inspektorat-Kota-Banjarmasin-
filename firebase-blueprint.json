{
  "entities": {
    "Instansi": {
      "title": "Instansi",
      "description": "Konfigurasi instansi pemerintah dan kop dinas resmi",
      "type": "object",
      "properties": {
        "namaPemda": { "type": "string" },
        "namaInstansi": { "type": "string" },
        "subJudul": { "type": "string" },
        "alamat": { "type": "string" },
        "telepon": { "type": "string" },
        "faksimile": { "type": "string" },
        "email": { "type": "string" },
        "website": { "type": "string" },
        "semboyan": { "type": "string" },
        "logoUtamaUrl": { "type": "string" },
        "logoSekunderUrl": { "type": "string" },
        "tampilkanLogoKanan": { "type": "boolean" },
        "ketebalanGarisKop": { "type": "string" }
      },
      "required": ["namaPemda", "namaInstansi"]
    },
    "Pejabat": {
      "title": "Pejabat",
      "description": "Master data pejabat penandatangan dokumen BMD",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "peran": { "type": "string" },
        "nama": { "type": "string" },
        "nip": { "type": "string" },
        "pangkatGol": { "type": "string" },
        "jabatan": { "type": "string" },
        "instansi": { "type": "string" }
      },
      "required": ["id", "nama", "nip", "jabatan"]
    },
    "Pegawai": {
      "title": "Pegawai",
      "description": "Data pegawai penerima dan pemakai barang milik daerah",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nama": { "type": "string" },
        "nip": { "type": "string" },
        "pangkatGol": { "type": "string" },
        "jabatan": { "type": "string" },
        "unitKerja": { "type": "string" },
        "status": { "type": "string" },
        "masaKerjaJabatan": { "type": "string" },
        "email": { "type": "string" },
        "telepon": { "type": "string" },
        "alamat": { "type": "string" }
      },
      "required": ["id", "nama", "nip"]
    },
    "BarangBMD": {
      "title": "BarangBMD",
      "description": "Data inventaris barang milik daerah",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "kodeBarang": { "type": "string" },
        "namaBarang": { "type": "string" },
        "merkTipe": { "type": "string" },
        "noSeri": { "type": "string" },
        "tahunPerolehan": { "type": "number" },
        "jumlah": { "type": "number" },
        "satuan": { "type": "string" },
        "nilaiPerolehan": { "type": "number" },
        "kondisi": { "type": "string" },
        "sumberDana": { "type": "string" },
        "kodeLokasiRuang": { "type": "string" },
        "fotoBarang": { "type": "string" },
        "statusPemakaian": { "type": "string" },
        "idPegawaiPemakai": { "type": "string" },
        "tanggalPelimpahan": { "type": "string" },
        "keterangan": { "type": "string" }
      },
      "required": ["id", "kodeBarang", "namaBarang", "statusPemakaian"]
    },
    "PelimpahanBMD": {
      "title": "PelimpahanBMD",
      "description": "Catatan pelimpahan pemakaian barang milik daerah kepada pegawai",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nomorBAST": { "type": "string" },
        "nomorSK": { "type": "string" },
        "nomorSPTJM": { "type": "string" },
        "tanggal": { "type": "string" },
        "idPegawai": { "type": "string" },
        "barangIds": { "type": "array" },
        "keperluan": { "type": "string" },
        "statusDokumen": { "type": "string" },
        "tandaTanganPihakPertama": { "type": "string" },
        "tandaTanganPihakKedua": { "type": "string" },
        "tandaTanganPenggunaBarang": { "type": "string" },
        "catatan": { "type": "string" }
      },
      "required": ["id", "idPegawai", "tanggal"]
    },
    "PelepasanAset": {
      "title": "PelepasanAset",
      "description": "Catatan pelepasan dan pengembalian aset BMD pegawai mutasi atau pensiun",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nomorBAP": { "type": "string" },
        "tanggal": { "type": "string" },
        "idPegawaiAsal": { "type": "string" },
        "namaPegawaiAsal": { "type": "string" },
        "nipPegawaiAsal": { "type": "string" },
        "jabatanPegawaiAsal": { "type": "string" },
        "unitKerjaPegawaiAsal": { "type": "string" },
        "alasan": { "type": "string" },
        "keteranganAlasan": { "type": "string" },
        "items": { "type": "array" },
        "statusPegawaiBaru": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "nomorBAP", "tanggal", "idPegawaiAsal"]
    },
    "Ruangan": {
      "title": "Ruangan",
      "description": "Master data lokasi dan kode ruangan inventaris BMD",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "kodeRuang": { "type": "string" },
        "namaRuang": { "type": "string" },
        "lantaiGedung": { "type": "string" },
        "penanggungJawab": { "type": "string" },
        "keterangan": { "type": "string" }
      },
      "required": ["id", "kodeRuang", "namaRuang"]
    },
    "GoogleSheetBackup": {
      "title": "GoogleSheetBackup",
      "description": "Riwayat pencadangan data ke Google Sheets",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "spreadsheetId": { "type": "string" },
        "spreadsheetUrl": { "type": "string" },
        "spreadsheetTitle": { "type": "string" },
        "createdAt": { "type": "string" },
        "accountEmail": { "type": "string" },
        "totalPegawai": { "type": "number" },
        "totalBarang": { "type": "number" },
        "totalPelimpahan": { "type": "number" }
      },
      "required": ["id", "spreadsheetUrl"]
    },
    "UnitKerja": {
      "title": "UnitKerja",
      "description": "Master data unit kerja dan wilayah kerja inspektorat",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "kodeUnit": { "type": "string" },
        "namaUnit": { "type": "string" },
        "wilayahKerja": { "type": "string" },
        "namaPimpinan": { "type": "string" },
        "nipPimpinan": { "type": "string" },
        "jabatanPimpinan": { "type": "string" },
        "kontakUnit": { "type": "string" },
        "keterangan": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "kodeUnit", "namaUnit", "wilayahKerja"]
    }
  },
  "firestore": {
    "/instansi/{id}": {
      "schema": "Instansi",
      "description": "Koleksi konfigurasi instansi dan kop dinas"
    },
    "/pejabat/{pejabatId}": {
      "schema": "Pejabat",
      "description": "Koleksi data pejabat penandatangan"
    },
    "/pegawai/{pegawaiId}": {
      "schema": "Pegawai",
      "description": "Koleksi data pegawai pemakai BMD"
    },
    "/barang/{barangId}": {
      "schema": "BarangBMD",
      "description": "Koleksi inventaris barang milik daerah"
    },
    "/pelimpahan/{pelimpahanId}": {
      "schema": "PelimpahanBMD",
      "description": "Koleksi riwayat pelimpahan dan dokumen BAP/SP"
    },
    "/pelepasan/{pelepasanId}": {
      "schema": "PelepasanAset",
      "description": "Koleksi riwayat pelepasan aset BMD dan BAP pengembalian"
    },
    "/ruangan/{ruanganId}": {
      "schema": "Ruangan",
      "description": "Koleksi master kode lokasi dan nama ruangan"
    },
    "/unitKerja/{unitKerjaId}": {
      "schema": "UnitKerja",
      "description": "Koleksi master data unit kerja dan wilayah kerja"
    },
    "/gsheet_backups/{backupId}": {
      "schema": "GoogleSheetBackup",
      "description": "Koleksi riwayat cadangan Google Spreadsheet"
    }
  }
}
